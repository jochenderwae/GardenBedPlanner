server {
    listen 0.0.0.0:__FRONTEND_PORT__;
    server_name _;

    root __APP_DIR__/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://__BACKEND_HOST__:__BACKEND_PORT__/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # nginx's built-in mime.types has no .webmanifest entry, so it falls back
    # to application/octet-stream - browsers tolerate that in practice, but
    # the correct type is application/manifest+json (#156).
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
