[Unit]
Description=GardenBedPlanner backend (FastAPI/uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/backend
ExecStart=__UV_PATH__ run uvicorn app.main:app --host __BACKEND_BIND_HOST__ --port __BACKEND_PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
