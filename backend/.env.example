DATABASE_URL=postgresql+psycopg://garden:garden@localhost:5432/garden
# Only used by test tooling (.claude/skills/test-backend, db-query's
# dev_psql_test.ps1), never by the app itself - a separate database on
# garden-planner-dev's Postgres, independent of the real DATABASE_URL above,
# so tests can freely CREATE/DROP/TRUNCATE without touching real data. See
# docs/testing-plan.md. Reachable directly from a dev laptop on the LAN
# (pg_hba.conf opened for this), not just over SSH.
TEST_DATABASE_URL=postgresql+psycopg://garden_test:CHANGEME@192.168.0.26:5432/garden_test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com
# "development" (default) keeps /docs, /redoc, /openapi.json available, as
# today. Set to "production" on any deployment reachable from outside a
# trusted LAN (see #176) to disable them - defense in depth on top of (not a
# substitute for) Basic Auth in front of the reverse proxy and never
# forwarding the backend's own directly-bound port externally.
ENVIRONMENT=development
